# Copy to .env for local runs. Every value here is fake or a safe default.
# Do not put real credentials in this file.

# Elastic stack version used by elasticsearch, kibana and filebeat.
ELASTIC_VERSION=8.15.3

# Elasticsearch JVM heap. Keep min and max equal.
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Host ports, bound to 127.0.0.1 only.
ES_PORT=9200
KIBANA_PORT=5601
FIXED_PORT=5002

# Wazuh manager image tag (used only with --profile wazuh).
WAZUH_VERSION=4.9.2

# Fake placeholder for the fixed app's secret key. Set a real random value
# only in your local .env, never commit it.
SENTINEL_SECRET_KEY=change-me-local-only
